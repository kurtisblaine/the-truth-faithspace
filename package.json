{
  "name": "workspace-name",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "npx nx",
    "start": "npx nx serve",
    "build": "npx nx build",
    "production": "npx nx build blog --prod --output-path apps/blog/public",
    "test": "npx nx test",
    "generate": "npx nx generate",
    "add": "npx nx add",
    "config": "npx nx config",
    "firebase:login": "cd ./apps/blog && firebase login",
    "firebase:serve": "npm run production && cd ./apps/blog && firebase serve",
    "firebase:deploy": "npm run production && cd ./apps/blog && firebase deploy",
    "example:generate:component": "npm run generate component discern-page/discern-list -- --skip-import",
    "example:generate:module": "npm run generate module discern-page",
    "example:generate:feature": "npx nx generate @ngrx/schematics:feature --name=discern --module=state.module.ts --flat=false --path=/apps/blog/src/app/state",
    "example:migrate": "npx nx migrate latest",
    "example:config:peer": "npm config set legacy-peer-deps true",
    "example:install:optional": "npm install --include=optional"
  },
  "private": true,
