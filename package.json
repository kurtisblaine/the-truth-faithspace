    "migrate:angular": "npx nx migrate @angular/core@latest && npx nx migrate @angular/cli@latest && npx nx migrate @angular/material@latest && npx nx migrate @angular-devkit/build-angular@latest",
    "npm:update": "npm update",
    "npm:cache:clear": "npm cache clean --force",
    "npm:update:global": "sudo npm install -g npm",
    "firebase:init": "firebase init",
    "firebase:hosting": "firebase init hosting",
    "firebase:login": "firebase login",
    "firebase:logout": "firebase logout",
    "firebase:serve": "firebase serve --only hosting",
    "firebase:deploy": "firebase deploy",
    "example:config:peer": "npm config set legacy-peer-deps true",
    "example:install:optional": "npm install --include=optional",
    "example:store": "npx nx generate @nx/angular:ngrx-feature-store --name=products/products --parent=./apps/flaresofglory/src/app/app.config.ts --no-interactive",
    "analyze:gospel": "nx build gospel --stats-json --named-chunks && npx -y @angular-experts/hawkeye ./apps/gospel/public/stats.json"
  },
