{
  "deafultProject": "static-gospel",
  "version": 1,
  "newProjectRoot": "apps",
  "projects": {
    "static-gospel": {
      "$schema": "../../node_modules/nx/schemas/project-schema.json",
      "projectType": "application",
      "sourceRoot": "apps/gospel/src",
      "prefix": "gospel",
      "tags": [],
      "targets": {
        "build": {
          "executor": "@angular-devkit/build-angular:browser",
          "outputs": ["{options.outputPath}"],
          "options": {
            "preserveSymlinks": true,
            "aot": true,
            "outputPath": "apps/gospel/public",
            "index": "apps/gospel/src/index.html",
            "main": "apps/gospel/src/main.ts",
            "polyfills": "apps/gospel/src/polyfills.ts",
            "tsConfig": "apps/gospel/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": ["apps/gospel/src/favicon.ico", "apps/gospel/src/assets"],
            "styles": ["apps/gospel/src/styles.scss"],
            "scripts": [
              "./node_modules/fullpage.js/dist/fullpage.js",
              "./node_modules/fullpage.js/dist/fullpage.extensions.min.js"
            ],
            "sourceMap": true,
            "namedChunks": true,
            "allowedCommonJsDependencies": ["guid-typescript", "photoswipe", "photoswipe/dist/photoswipe-ui-default"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "10mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "5kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "apps/gospel/src/environments/environment.ts",
                  "with": "apps/gospel/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "executor": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "gospel:build:production"
            },
            "development": {
              "buildTarget": "gospel:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "executor": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "gospel:build"
          }
        },
        "lint": {
          "executor": "@nrwl/linter:eslint",
          "options": {
            "lintFilePatterns": ["apps/gospel/**/*.ts", "apps/gospel/**/*.html"]
          }
        },
        "deploy": {
          "builder": "@angular/fire:deploy",
          "options": {
            "browserTarget": "gospel:build:production",
            "serverTarget": "gospel:server:production",
            "prerenderTarget": "gospel:prerender:production"
          }
        },
        "server": {
          "dependsOn": ["build"],
          "executor": "@angular-devkit/build-angular:server",
          "options": {
            "outputPath": "dist/apps/gospel/server",
            "main": "apps/gospel/server.ts",
            "tsConfig": "apps/gospel/tsconfig.server.json",
            "sourceMap": true,
            "inlineStyleLanguage": "scss"
          },
          "configurations": {
            "production": {
              "outputHashing": "media",
              "fileReplacements": [
                {
                  "replace": "apps/gospel/src/environments/environment.ts",
                  "with": "apps/gospel/src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false,
              "vendorChunk": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-ssr": {
          "executor": "@angular-devkit/build-angular:ssr-dev-server",
          "configurations": {
            "development": {
              "browserTarget": "gospel:build:development",
              "serverTarget": "gospel:server:development"
            },
            "production": {
              "browserTarget": "gospel:build:production",
              "serverTarget": "gospel:server:production"
            }
          },
          "defaultConfiguration": "development"
        },
        "prerender": {
          "executor": "@angular-devkit/build-angular:prerender",
          "options": {
            "routes": ["/"]
          },
          "configurations": {
            "development": {
              "browserTarget": "gospel:build:development",
              "serverTarget": "gospel:server:development"
            },
            "production": {
              "browserTarget": "gospel:build:production",
              "serverTarget": "gospel:server:production"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
