{
  "name": "bible",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/bible/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/bible",
        "index": "apps/bible/src/index.html",
        "browser": "apps/bible/src/main.ts",
        "tsConfig": "apps/bible/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": ["apps/bible/src/favicon.ico", "apps/bible/src/assets"],
        "styles": ["apps/bible/src/styles.scss"],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ],
          "outputHashing": "all",
          "outputPath": "apps/bible/public"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "bible:build:production"
        },
        "development": {
          "buildTarget": "bible:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "bible:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/bible/**/*.ts", "apps/bible/**/*.html"]
      }
    },
    "deploy": {
      "executor": "@angular/fire:deploy",
      "options": {
        "version": 2
      },
      "configurations": {
        "production": {
          "buildTarget": "bible:build:production",
          "serveTarget": "bible:serve:production"
        },
        "development": {
          "buildTarget": "bible:build:development",
          "serveTarget": "bible:serve:development"
        }
      },
      "defaultConfiguration": "production"
    }
  }
}
