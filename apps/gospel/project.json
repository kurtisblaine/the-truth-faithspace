{
  "name": "gospel",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/gospel/src",
  "prefix": "gospel",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser-esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "aot": true,
        "outputPath": "apps/gospel/public",
        "index": "apps/gospel/src/index.html",
        "main": "apps/gospel/src/main.ts",
        "tsConfig": "apps/gospel/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": ["apps/gospel/src/favicon.ico", "apps/gospel/src/assets", "apps/gospel/src/robots.txt"],
        "styles": ["apps/gospel/src/styles.scss"],
        "scripts": ["./node_modules/fullpage.js/dist/fullpage.min.js"],
        "sourceMap": true,
        "namedChunks": true,
        "allowedCommonJsDependencies": ["photoswipe", "photoswipe/dist/photoswipe-ui-default"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "10mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "5kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/gospel/src/environments/environment.ts",
              "with": "apps/gospel/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all",
          "buildOptimizer": true,
          "optimization": true,
          "sourceMap": false
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "statsJson": true
        }
      },
      "defaultConfiguration": "production"
    },
    "build-static": {
      "executor": "@nx/angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "apps/gospel/static",
        "index": "apps/gospel/src/index.html",
        "tsConfig": "apps/gospel/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": ["apps/gospel/src/favicon.ico", "apps/gospel/src/assets", "apps/gospel/src/robots.txt"],
        "styles": ["apps/gospel/src/styles.scss"],
        "scripts": ["./node_modules/fullpage.js/dist/fullpage.min.js"],
        "namedChunks": true,
        "allowedCommonJsDependencies": ["photoswipe", "photoswipe/dist/photoswipe-ui-default"],
        "server": "apps/gospel/src/main.server.ts",
        "outputMode": "static"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "10mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "5kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/gospel/src/environments/environment.ts",
              "with": "apps/gospel/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "statsJson": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "gospel:build:production"
        },
        "development": {
          "buildTarget": "gospel:build:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "gospel:build"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["apps/gospel/**/*.ts", "apps/gospel/**/*.html"]
      }
    },
    "deploy": {
      "builder": "@angular/fire:deploy",
      "options": {
        "browserTarget": "gospel:build:production",
        "serverTarget": "gospel:server:production",
        "prerenderTarget": "gospel:prerender:production"
      }
    },
    "prerender": {
      "executor": "@angular-devkit/build-angular:prerender",
      "options": {
        "routes": [
          "/truth",
          "/home",
          "email",
          "/discernments",
          "/edifications",
          "/insights",
          "/poems",
          "/studies",
          "/drawings",
          "/tracts"
        ]
      },
      "configurations": {
        "development": {
          "browserTarget": "gospel:build:development",
          "serverTarget": "gospel:server:development"
        },
        "production": {
          "browserTarget": "gospel:build:production",
          "serverTarget": "gospel:server:production"
        }
      },
      "defaultConfiguration": "production"
    }
  }
}
