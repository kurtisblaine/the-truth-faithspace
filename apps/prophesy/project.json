{
  "name": "prophesy",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/prophesy/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "apps/prophesy/public",
        "index": "apps/prophesy/src/index.html",
        "browser": "apps/prophesy/src/main.ts",
        "tsConfig": "apps/prophesy/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "namedChunks": true,
        "assets": ["apps/prophesy/src/favicon.ico", "apps/prophesy/src/assets", "apps/prophesy/src/robots.txt"],
        "styles": ["apps/prophesy/src/styles.scss"],
        "scripts": [],
        "server": "apps/prophesy/src/main.server.ts",
        "outputMode": "static"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/prophesy/src/environments/environment.ts",
              "with": "apps/prophesy/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "prophesy:build:production"
        },
        "development": {
          "buildTarget": "prophesy:build:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "prophesy:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "prophesy:build",
        "staticFilePath": "dist/apps/prophesy/browser",
        "spa": true
      }
    }
  }
}
