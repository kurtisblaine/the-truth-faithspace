{
  "name": "technology",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/technology/src",
  "prefix": "app",
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "commonChunk": false,
      "options": {
        "outputPath": "apps/technology/public",
        "index": "apps/technology/src/index.html",
        "browser": "apps/technology/src/main.ts",
        "tsConfig": "apps/technology/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": ["apps/technology/src/favicon.ico", "apps/technology/src/assets", "apps/technology/src/robots.txt"],
        "styles": ["apps/technology/src/styles.scss"],
        "scripts": [],
        "server": "apps/technology/src/main.server.ts",
        "outputMode": "static"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "900kB",
              "maximumError": "3MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kB",
              "maximumError": "8kB"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/technology/src/environments/environment.ts",
              "with": "apps/technology/src/environments/environment.prod.ts"
            }
          ],
          "namedChunks": true
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      }
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "technology:build:production"
        },
        "development": {
          "buildTarget": "technology:build:development"
        }
      },
      "options": {
        "headers": {
          "Content-Security-Policy": "style-src 'self' 'unsafe-inline';",
          "X-Frame-Options": "SAMEORIGIN",
          "X-Content-Type-Options": "nosniff",
          "Referrer-Policy": "strict-origin-when-cross-origin"
        }
      },
      "defaultConfiguration": "development"
    }
  }
}
