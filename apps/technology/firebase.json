{
  "hosting": {
    "site": "shining-light-on-the-dark-web",
    "public": "public/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "rewrites": [
    {
      "source": "**",
      "destination": "/index.html"
    }
  ],
  "database": {
    "rules": "database.rules.json"
  }
}
